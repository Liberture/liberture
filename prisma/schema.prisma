// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model KnowledgeArticle {
  id          String   @id @default(cuid())
  title       String
  description String
  pillar      String
  tags        String // JSON array as string
  author      String
  readTime    Int
  url         String
  publishedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketplaceItem {
  id          String   @id @default(cuid())
  title       String
  description String
  pillar      String
  type        String // "premium" | "opensource"
  author      String
  rating      Float
  reviews     Int
  price       Int
  duration    String
  color       String
  iconColor   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Content {
  id           String   @id @default(cuid())
  title        String
  description  String
  pillar       String
  type         String
  author       String // JSON object as string
  influencerScore Int?
  rating       Float
  reviews      Int
  price        Int
  duration     String
  tags         String // JSON array as string
  outcomes     String // JSON array as string
  prerequisites String? // JSON array as string
  difficulty   String
  bioScores    String // JSON object as string
  lessonCount  Int?
  contentUrl   String?
  socialLinks  String? // JSON object as string
  updates      String? // JSON array as string
  relatedContent String? // JSON array as string
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SocialPost {
  id          String   @id @default(cuid())
  author      String
  avatarUrl   String
  timeAgo     String
  content     String
  likes       Int
  comments    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlatformComment {
  id         String   @id @default(cuid())
  contentId  String
  author     String
  avatarUrl  String
  timeAgo    String
  comment    String
  helpful    Int
  replies    Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String
  image         String?
  password      String?
  bosLevel      Int       @default(1)
  role          String    @default("user")
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  accountId         String
  providerId        String
  accessToken       String?
  refreshToken      String?
  idToken           String?
  expiresAt         DateTime?
  password          String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// Directory models
model Person {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  title       String
  bio         String
  pillars     String // Comma-separated pillar IDs
  expertise   String
  followers   String?
  website     String?
  twitter     String?
  instagram   String?
  youtube     String?
  podcast     String?
  imageUrl    String?
  achievements String? // JSON array
  publications String? // JSON array
  protocols   String? // JSON array of protocol IDs
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Organization {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  pillars     String // Comma-separated
  type        String // "research", "platform", "community", etc.
  founded     String?
  website     String
  resources   String? // JSON array
  keyPeople   String? // JSON array of person IDs
  featured    Boolean  @default(false)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Protocol {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  pillar      String
  creator     String? // Person ID or name
  duration    String?
  difficulty  String // "beginner", "intermediate", "advanced"
  steps       String // JSON array
  benefits    String // JSON array
  risks       String? // JSON array
  equipment   String? // JSON array
  references  String? // JSON array
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Book {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  author      String
  description String
  pillars     String // Comma-separated
  year        Int?
  pages       Int?
  isbn        String?
  amazonUrl   String?
  rating      Float?
  keyTakeaways String? // JSON array
  forWho      String? // Who should read this
  featured    Boolean  @default(false)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Newsletter {
  id          String   @id @default(cuid())
  email       String   @unique
  subscribed  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  replied   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
