generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id           String    @id
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  idToken      String?
  expiresAt    DateTime?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  User         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Book {
  id            String   @id
  slug          String   @unique
  title         String
  author        String
  description   String
  pillars       String
  year          Int?
  pages         Int?
  isbn          String?
  amazonUrl     String?
  rating        Float?
  keyTakeaways  String?
  forWho        String?
  featured      Boolean  @default(false)
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  publications  String?
  wikipedia     String?
  authorId      String?
  goodreadsUrl  String?
  authorPubkey  String?
  nostrEventId  String?
  nostrDTag     String?
  wotScore      Float?
  Person        Person?  @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

model ContactMessage {
  id        String   @id
  name      String
  email     String
  subject   String?
  message   String
  replied   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Content {
  id              String   @id
  title           String
  description     String
  pillar          String
  type            String
  author          String
  influencerScore Int?
  rating          Float
  reviews         Int
  price           Int
  duration        String
  tags            String
  outcomes        String
  prerequisites   String?
  difficulty      String
  bioScores       String
  lessonCount     Int?
  contentUrl      String?
  socialLinks     String?
  updates         String?
  relatedContent  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime
}

model EnrichmentLog {
  id          String   @id
  entityType  String
  entityId    String
  entityName  String
  fieldsAdded String
  source      String   @default("manual")
  enrichedBy  String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model KnowledgeArticle {
  id            String        @id
  title         String
  description   String
  pillar        String
  tags          String
  author        String
  readTime      Int
  url           String
  publishedAt   DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  slug          String        @unique
  viewCount     Int           @default(0)
  content       String?       @db.Text
  authorPubkey  String?
  nostrEventId  String?
  nostrDTag     String?
  wotScore      Float?
  views         ArticleView[]
}

model ArticleView {
  id        String            @id
  articleId String
  viewedAt  DateTime          @default(now())
  userAgent String?
  referrer  String?
  article   KnowledgeArticle  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([viewedAt])
  @@index([articleId, viewedAt])
}

model MarketplaceItem {
  id          String   @id
  title       String
  description String
  pillar      String
  type        String
  author      String
  rating      Float
  reviews     Int
  price       Int
  duration    String
  color       String
  iconColor   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  slug        String   @unique
}

model Newsletter {
  id         String   @id
  email      String   @unique
  subscribed Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}

model Organization {
  id            String   @id
  slug          String   @unique
  name          String
  description   String
  pillars       String
  type          String
  founded       String?
  website       String
  resources     String?
  keyPeople     String?
  featured      Boolean  @default(false)
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  publications  String?
  wikipedia     String?
  authorPubkey  String?
  nostrEventId  String?
  nostrDTag     String?
  wotScore      Float?
}

model Person {
  id             String   @id
  slug           String   @unique
  name           String
  title          String
  bio            String
  pillars        String
  expertise      String
  followers      String?
  website        String?
  twitter        String?
  instagram      String?
  youtube        String?
  podcast        String?
  imageUrl       String?
  achievements   String?
  publications   String?
  protocols      String?
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  speakingEvents String?
  wikipedia      String?
  category       String   @default("practitioner")
  Book           Book[]
}

model PlatformComment {
  id        String   @id
  contentId String
  author    String
  avatarUrl String
  timeAgo   String
  comment   String
  helpful   Int
  replies   Int
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Protocol {
  id            String   @id
  slug          String   @unique
  name          String
  description   String
  pillar        String
  creator       String?
  duration      String?
  difficulty    String
  steps         String
  benefits      String
  risks         String?
  equipment     String?
  references    String?
  featured      Boolean  @default(false)
  published     Boolean  @default(false)
  authorPubkey  String?
  nostrEventId  String?
  nostrDTag     String?
  wotScore      Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SocialPost {
  id        String   @id
  author    String
  avatarUrl String
  timeAgo   String
  content   String
  likes     Int
  comments  Int
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model User {
  id                 String    @id
  email              String    @unique
  emailVerified      Boolean   @default(false)
  name               String
  image              String?
  password           String?
  nostrPubkey        String?   @unique
  bosLevel           Int       @default(1)
  role               String    @default("user")
  banned             Boolean   @default(false)
  banReason          String?
  banExpires         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime
  emailNotifications Boolean   @default(true)
  marketingEmails    Boolean   @default(true)
  newContentAlerts   Boolean   @default(false)
  weeklyDigest       Boolean   @default(true)
  Account            Account[]
  Session            Session[]
  Bookmark           Bookmark[]
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@index([entityType, entityId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@unique([identifier, value])
}

model ScrapedContent {
  id                  String    @id
  source              String
  sourceUrl           String
  rawContent          String
  contentType         String
  targetEntity        String?
  extractedData       Json?
  needsParaphrasing   Boolean   @default(true)
  paraphrasedContent  String?
  enrichmentStatus    String    @default("pending")
  enrichedBy          String?
  enrichedAt          DateTime?
  publishedToDb       Boolean   @default(false)
  publishedEntityId   String?
  scrapedAt           DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime

  @@index([source])
  @@index([enrichmentStatus])
  @@index([needsParaphrasing])
  @@index([contentType])
}

// Nostr Collaboration System

model NostrAccount {
  id            String   @id @default(cuid())
  npub          String   @unique
  pubkeyHex     String   @unique
  role          String   @default("liberture") // "liberture" | "collaborator"
  nbunkerUrl    String?  // NIP-46 bunker URL for signing (liberture account only)
  nbunkerSecret String?  // optional secret — NOTE: should be encrypted at rest in production
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CollaborationRequest {
  id          String    @id @default(cuid())
  npub        String
  pubkeyHex   String
  message     String?   // optional "why I want to collaborate" message
  status      String    @default("pending") // "pending" | "approved" | "rejected"
  reviewedAt  DateTime?
  reviewedBy  String?   // admin npub or user id
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([npub])
}

model Collaborator {
  id           String   @id @default(cuid())
  npub         String   @unique
  pubkeyHex    String   @unique
  displayName  String?
  about        String?
  picture      String?
  nostrProfile Json?    // cached kind 0 event data
  isActive     Boolean  @default(true)
  wotScore     Float?
  approvedAt   DateTime @default(now())
  approvedBy   String?

  @@index([pubkeyHex])
}
