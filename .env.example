# PostgreSQL, shared by Prisma (content) and the habit tracker
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/liberture?schema=public

# Optional
ADMIN_NOSTR_PUBKEYS=
ADMIN_SECRET=
HABIT_TRACKER_TIME_ZONE=America/Argentina/Buenos_Aires
RESEND_API_KEY=

# Optional: Web Push, for reminders and coach check-ins with the app closed.
# Generate once with `node scripts/generate-vapid-keys.mjs` and keep them. See docs/REMINDERS.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@liberture.com
# REMINDER_SCHEDULER=off
