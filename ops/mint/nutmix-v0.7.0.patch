+// The wallet proxy exposes payment history scoped to the authenticated wallet.
+func (l LnbitsWallet) paymentStatus(hash string, outgoing bool, status *LNBitsPaymentStatus) error {
+	var rows []struct {
+		PaymentHash string `json:"payment_hash"`
+		Amount      int64
+		Fee         int64
+		Status      string
+		Preimage    string
+	}
+	err := l.LnbitsRequest("GET", "/api/v1/payments?limit=2&payment_hash="+hash, nil, &rows)
+	if err != nil {
+		return err
+	}
+	for _, row := range rows {
+		if row.PaymentHash != hash || row.Amount == 0 || (row.Amount < 0) != outgoing {
+			continue
+		}
+		switch row.Status {
+		case "success":
+			status.Paid = true
+		case "pending":
+			status.Pending = true
+		case "failed":
+		default:
+			return errors.New("unrecognized wallet payment status")
+		}
+		status.Details.Fee = row.Fee
+		status.Preimage = row.Preimage
+		return nil
+	}
+	return errors.New("wallet payment record unavailable")
+}
