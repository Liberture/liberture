+package cashu
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestErrorResponseContainsSDKRequiredDetail(t *testing.T) {
+	encoded, err := json.Marshal(ErrorCodeToResponse(MINT_QUOTE_INVALID_SIG, nil))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var response map[string]any
+	if err := json.Unmarshal(encoded, &response); err != nil {
+		t.Fatal(err)
+	}
+	if response["code"] != float64(20008) || response["detail"] != MINT_QUOTE_INVALID_SIG.String() {
+		t.Fatalf("wallet cannot recognize signature retry: %s", encoded)
+	}
+}
