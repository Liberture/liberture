diff --git a/internal/lightning/proxy_contract_test.go b/internal/lightning/proxy_contract_test.go
new file mode 100644
index 0000000..cc2b0ce
--- /dev/null
+++ b/internal/lightning/proxy_contract_test.go
@@ -0,0 +1,40 @@
+package lightning
+
+import (
+	"encoding/json"
+	"github.com/lescuer97/nutmix/api/cashu"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestInvoiceRequestMatchesRestrictedProxy(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != "POST" || r.URL.Path != "/api/v1/payments" || r.Header.Get("Content-Type") != "application/json" {
+			t.Errorf("unexpected request")
+		}
+		var body map[string]any
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Fatal(err)
+		}
+		for field := range body {
+			if field != "out" && field != "unit" && field != "amount" && field != "memo" {
+				t.Errorf("proxy rejects field %s", field)
+			}
+		}
+		if body["out"] != false || body["unit"] != "sat" || body["amount"] != float64(100) {
+			t.Errorf("unexpected invoice values: %v", body)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		w.Write([]byte(`{"payment_hash":"test-hash","bolt11":"test-invoice"}`))
+	}))
+	defer server.Close()
+	wallet := LnbitsWallet{Endpoint: server.URL, Key: "test-only"}
+	result, err := wallet.RequestInvoice(cashu.Amount{Unit: cashu.Sat, Amount: 100}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.PaymentRequest != "test-invoice" {
+		t.Fatal("invoice lost")
+	}
+}
