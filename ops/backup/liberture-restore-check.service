[Unit]
Description=Verify the latest Liberture backup in an isolated temporary PostgreSQL cluster
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
User=liberture_backup
Group=liberture_backup
RestrictSUIDSGID=true
EnvironmentFile=/etc/liberture-backup/storage.env
ExecStart=/usr/bin/python3 /usr/local/libexec/liberture-backup/restore-check.py
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
